  "section2": {
    "broad_features": {
      "creator_history_n": {
        "classification": "CLEAN",
        "file": "src/trencher/baselines/features.py",
        "note": "Same creator-history path as creator_prior_*; pre-T creator stats."
      },
      "creator_prior_rank": {
        "classification": "CLEAN",
        "file": "src/trencher/baselines/features.py",
        "lines": "200-201",
        "note": "Creator priors are launch-time / history-before-mint fields in broad feature construction; not selected via post-T trade extremes."
      },
      "daily_network_*": {
        "classification": "CLEAN",
        "file": "src/trencher/data/world_model/training/global_batch.py",
        "function": "last_completed_utc_day",
        "lines": "23-32, 183-194",
        "quote": "Daily aggregates: last fully completed UTC day strictly before T (never the incomplete calendar day containing T)."
      },
      "global_launches_1h_24h": {
        "classification": "CLEAN",
        "file": "src/trencher/data/world_model/training/global_batch.py",
        "function": "GlobalContextBatch.load_for_t / _count",
        "lines": "176-187",
        "quote": "hi = searchsorted(arr_t, last_sec, side='right'); window back from last_completed_second(T)"
      },
      "other_broad_window_past_T": {
        "classification": "CLEAN",
        "note": "Broad event/curve windows are causal sequence prefixes / last-N before T in baseline feature_cache; no additional lifetime-stratified RPC selection."
      },
      "token_age_seconds": {
        "classification": "CLEAN",
        "note": "T - detected_at; no future dependence."
      }
    },
    "q85_test_accessed": false,
    "rich_groups": {
      "graph": {
        "classification": "CLEAN",
        "evidence": "Graph-token edges are derived from the full event sequence store for the mint, then observation refs slice by observation_time_t. Selection of which event rows exist is not driven by lifetime max/last stratified RPC targets. Causal filter at T is enforced in packs_for_observation.",
        "file": "src/trencher/data/world_model/sequences.py",
        "function": "_build_graph_token_store",
        "lines": "815-848",
        "quote": "for row in sequence_events_v2: append wallet_token_{side} edge (all event rows, not stratified by future peaks)"
      },
      "microstructure": {
        "also": "ownership.py ~396 uses signature_targets wallets for trade_wallets coverage",
        "classification": "LEAK",
        "evidence": "extract_signature_targets scans full-lifetime trades into a per-mint reservoir, then select_stratified_trades_for_mint picks first/last/median buy-sell/largest/max-curve/temporal grid. Only those signatures receive getTransaction RPC. At observation T, micro_n counts selected txs with time<T, but which txs were selected depends on post-T extremes.",
        "file": "src/trencher/data/world_model/acquire/local_corpus.py",
        "function": "select_stratified_trades_for_mint",
        "lines": "131-177",
        "quote": "add(ordered[0]); add(ordered[-1]); ... by_size[-1]; by_curve[-1]; temporal grid over lifetime ordered trades"
      },
      "ownership": {
        "classification": "LEAK",
        "evidence": "Ownership RPC token-balance recovery and trade-wallet universe are keyed off the same lifetime-stratified signature_targets, so which ownership edges exist inherits the microstructure selection leak. Per-observation slicing still uses t<T, but record membership is future-dependent.",
        "file": "src/trencher/data/world_model/ownership.py",
        "function": "build_ownership_evidence / trade_wallets from signature_targets",
        "lines": "395-405",
        "quote": "st_path = world_root / 'microstructure' / 'signature_targets.parquet'; trade_wallets[mint].add(wallet)"
      },
      "wallet_prior": {
        "classification": "CLEAN",
        "evidence": "Wallet set comes from graph-token edges available at T; each wallet's prior events are truncated to event_time < T. Forbidden lifetime edges_wallet_token aggregates are explicitly not used.",
        "file": "src/trencher/baselines/rich_index.py",
        "function": "_wallet_prior_pack / CausalRichSequenceIndex",
        "lines": "184-221, 248-252",
        "quote": "wallets from graph pack at T; prior history end = searchsorted(times, T); last N before T"
      }
    }
  },
